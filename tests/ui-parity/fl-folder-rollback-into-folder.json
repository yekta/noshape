{
 "name": "fl-folder-rollback-into-folder",
 "about": "spline-parts: folder Block (Sketch 2, Extrude 2), opened by its chevron, rollback bar dragged below Sketch 2 inside it",
 "area": "part-studio",
 "source": "live depth batch 11 (the feature list as makers use it; lead 11-28)",
 "start": "spline-parts",
 "feature_tree": true,
 "steps": [
  {
   "do": "click",
   "on": {
    "feature": "Sketch 2"
   }
  },
  {
   "do": "click",
   "on": {
    "feature": "Extrude 2"
   },
   "mods": "shift"
  },
  {
   "do": "click",
   "on": {
    "button": "New folder"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 600
  },
  {
   "do": "key",
   "key": "mod+a"
  },
  {
   "do": "type",
   "text": "Block"
  },
  {
   "do": "key",
   "key": "Enter"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1200
  },
  {
   "do": "click",
   "on": {
    "expander": "Block"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 800
  },
  {
   "do": "drag",
   "from": {
    "rollback_bar": true
   },
   "to": {
    "rollback_to": "Sketch 2"
   }
  },
  {
   "do": "wait",
   "until": "regenerated"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1200
  }
 ]
}