{
 "name": "ver-compare-feature-studio",
 "about": "Feature Studio 1 edited and committed after V1, then Compare V1 on the Feature Studio tab (two diff editors)",
 "area": "psui",
 "source": "universe versions (psui 11-09, studios.md Versions list)",
 "start": "fs-versioned",
 "steps": [
  {
   "do": "click",
   "on": {
    "doc_tab": "Feature Studio 1"
   }
  },
  {
   "do": "click",
   "on": {
    "editor": "code"
   }
  },
  {
   "do": "key",
   "key": "mod+End"
  },
  {
   "do": "key",
   "key": "Enter"
  },
  {
   "do": "type",
   "text": "// uip"
  },
  {
   "do": "click",
   "on": {
    "button": "Commit Feature Studio"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Versions and history"
   }
  },
  {
   "do": "rclick",
   "on": {
    "history_row": "V1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Compare"
   }
  }
 ]
}
