{
 "name": "ver-compare-moved-feature",
 "about": "Sketch 2 dragged above Extrude 1, then Compare V1: the moved feature's amber arrows",
 "area": "psui",
 "source": "universe versions (psui 11-09, studios.md Versions list)",
 "start": "doc-versions-reorder",
 "steps": [
  {
   "do": "drag",
   "from": {
    "feature": "Sketch 2"
   },
   "to": {
    "feature": "Extrude 1",
    "edge": "top"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Versions and history"
   }
  },
  {
   "do": "rclick",
   "on": {
    "history_row": "V1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Compare"
   }
  }
 ]
}
