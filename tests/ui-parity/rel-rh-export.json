{
 "name": "rel-rh-export",
 "about": "After releasing Part 1: Revision history › the row's Export",
 "area": "studios",
 "source": "spec from Onshape docs, not recordable on live's plan (studios 11-08, release batch 1) Recordable since 11-14 (Professional): a company-owned start (live2 COMPANYOWNED=1), managed workflows on. Recorded by live 11-15 (company-owned doc-versions, workflows on).",
 "recordable": true,
 "start": "doc-versions",
 "config_files": {
  "release_settings.json": {
   "managed_workflows": true
  }
 },
 "steps": [
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Release…"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 5000
  },
  {
   "do": "click",
   "on": {
    "field": "Part number:Part 1"
   }
  },
  {
   "do": "type",
   "text": "PN-0302Z"
  },
  {
   "do": "click",
   "on": {
    "field": "Release name"
   }
  },
  {
   "do": "type",
   "text": "R1"
  },
  {
   "do": "click",
   "on": {
    "field": "Release notes"
   }
  },
  {
   "do": "type",
   "text": "First release"
  },
  {
   "do": "click",
   "on": {
    "button": "Release"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 20000
  },
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Revision history…"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 3000
  },
  {
   "do": "click",
   "on": {
    "button": "Export"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 3000
  }
 ]
}