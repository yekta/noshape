{
 "name": "vs-edit-propagates-to-part",
 "about": "vs-vars: Depth #height, then Variable Studio 1's height 15 mm: back in Part Studio 1 the part is 15 mm deep",
 "area": "part-studio",
 "source": "live depth batch 10 (parametric making; lead 11-27)",
 "start": "vs-vars",
 "steps": [
  {
   "do": "click",
   "on": {
    "doc_tab": "Part Studio 1"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 3000
  },
  {
   "do": "dblclick",
   "on": {
    "feature": "Extrude 1"
   }
  },
  {
   "do": "wait",
   "until": "dialog"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 800
  },
  {
   "do": "click",
   "on": {
    "field": "Depth"
   }
  },
  {
   "do": "key",
   "key": "mod+a"
  },
  {
   "do": "type",
   "text": "#height"
  },
  {
   "do": "key",
   "key": "Enter"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 2000
  },
  {
   "do": "click",
   "on": {
    "button": "ok"
   }
  },
  {
   "do": "wait",
   "until": "regenerated"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1500
  },
  {
   "do": "click",
   "on": {
    "doc_tab": "Variable Studio 1"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1500
  },
  {
   "do": "click",
   "on": {
    "var_cell": "height:Value"
   }
  },
  {
   "do": "key",
   "key": "mod+a"
  },
  {
   "do": "type",
   "text": "15 mm"
  },
  {
   "do": "key",
   "key": "Enter"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1500
  },
  {
   "do": "click",
   "on": {
    "doc_tab": "Part Studio 1"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 3000
  },
  {
   "do": "click",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Mass properties"
   }
  },
  {
   "do": "wait",
   "until": "dialog"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1500
  }
 ]
}