{
  "name": "drw-dimension-point-to-line",
  "about": "Point to line dimension from the block's corner to its right edge in Top, placed below it",
  "area": "dx",
  "ticket": "DRAWING-UI-PARITY",
  "source": "coverage (lead 11-06: most-used drawing tools first)",
  "start": "block-drawing",
  "steps": [
    {
      "do": "click",
      "on": {
        "tool": "Dimension",
        "menu": "Point to line dimension"
      }
    },
    {
      "do": "click",
      "on": {
        "view_point": {
          "view": "Top",
          "at": [
            0,
            0,
            10
          ]
        }
      }
    },
    {
      "do": "click",
      "on": {
        "view_edge": {
          "view": "Top",
          "at": [
            40,
            15,
            10
          ]
        }
      }
    },
    {
      "do": "click",
      "on": {
        "view_point": {
          "view": "Top",
          "at": [
            20,
            -10,
            10
          ]
        }
      }
    },
    {
      "do": "key",
      "key": "Escape"
    }
  ]
}
