{
 "name": "fl-folder-make-named",
 "about": "spline-parts: Sketch 2 and Extrude 2 selected, New folder, named Block",
 "area": "part-studio",
 "source": "live depth batch 11 (the feature list as makers use it; lead 11-28)",
 "start": "spline-parts",
 "feature_tree": true,
 "steps": [
  {
   "do": "click",
   "on": {
    "feature": "Sketch 2"
   }
  },
  {
   "do": "click",
   "on": {
    "feature": "Extrude 2"
   },
   "mods": "shift"
  },
  {
   "do": "click",
   "on": {
    "button": "New folder"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 600
  },
  {
   "do": "key",
   "key": "mod+a"
  },
  {
   "do": "type",
   "text": "Block"
  },
  {
   "do": "key",
   "key": "Enter"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1200
  }
 ]
}