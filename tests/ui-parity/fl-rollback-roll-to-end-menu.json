   "on": {
    "feature": "Extrude 3"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 500
  },
  {
   "do": "click",
   "on": {
    "menu": "Roll to end"
   }
  },
  {
   "do": "wait",
   "until": "regenerated"
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1200
  }
 ]
