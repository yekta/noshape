{
 "name": "rel-rc-save-draft",
 "about": "Release… with a part number and a release name, Save draft, then the left rail's Release drafts: the draft listed",
 "area": "studios",
 "source": "spec from Onshape docs, not recordable on live's plan (studios 11-08, release batch 1)",
 "recordable": false,
 "start": "doc-versions",
 "steps": [
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Release…"
   }
  },
  {
   "do": "click",
   "on": {
    "field": "Part number:Part 1"
   }
  },
  {
   "do": "type",
   "text": "PN-0001"
  },
  {
   "do": "click",
   "on": {
    "field": "Release name"
   }
  },
  {
   "do": "type",
   "text": "R1"
  },
  {
   "do": "click",
   "on": {
    "button": "Save draft"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Release drafts"
   }
  }
 ]
}
