{
 "name": "drw-dimension-tolerance-symmetrical",
 "about": "1.575's palette: Precision 0.12, Tolerance Symmetrical, .01 typed in the tolerance field, closed by a click on the sheet",
 "area": "dx",
 "source": "studios 11-12 (drawing gap audit, behaviours L29910)",
 "start": "block-drawing",
 "steps": [
