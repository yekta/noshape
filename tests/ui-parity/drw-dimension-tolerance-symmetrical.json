   "do": "click",
   "on": {
    "tool": "Dimension"
   }
  },
  {
   "do": "click",
   "on": {
    "view_edge": {
     "view": "Front",
     "at": [
      20,
      0,
      10
     ]
    }
   }
  },
  {
   "do": "click",
   "on": {
    "view_point": {
     "view": "Front",
     "at": [
      20,
      0,
      18
     ]
    }
   }
  },
  {
   "do": "key",
   "key": "Escape"
  },
  {
   "do": "dblclick",
   "on": {
    "annotation": "1.575"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 800
  },
  {
   "do": "click",
   "on": {
    "button": "Precision: 0.123 (Drawing)"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "0.12"
   }
