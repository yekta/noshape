{
 "name": "rel-drafts-panel",
 "about": "Release… filled in, Save draft; the left rail's Release drafts lists R1; double-click it: Review Release: R1, editable; its Save draft ▴ › Delete draft",
 "area": "studios",
 "source": "spec from Onshape docs, not recordable on live's plan (studios 11-08, release batch 1) Recordable since 11-14 (Professional): a company-owned start (live2 COMPANYOWNED=1), managed workflows on.",
 "recordable": true,
 "start": "doc-versions",
 "config_files": {
  "release_settings.json": {
   "managed_workflows": true
  }
 },
 "steps": [
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Release…"
   }
  },
  {
   "do": "click",
   "on": {
    "field": "Part number:Part 1"
   }
  },
  {
   "do": "type",
   "text": "PN-0001"
  },
  {
   "do": "click",
   "on": {
    "field": "Release name"
   }
  },
  {
   "do": "type",
   "text": "R1"
  },
  {
   "do": "click",
   "on": {
    "button": "Save draft"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Release drafts"
   }
  },
  {
   "do": "dblclick",
   "on": {
    "panel_row": "R1"
   }
  },
  {
   "do": "click",
   "on": {
    "caret": "Save draft"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Delete draft"
   }
  }
 ]
}
