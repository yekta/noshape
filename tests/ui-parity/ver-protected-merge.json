 "start": "doc-branches",
 "steps": [
  {
   "do": "click",
   "on": {
    "button": "Versions and history"
   }
  },
  {
   "do": "rclick",
   "on": {
    "history_row": "Main"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Workspace protection…"
   }
  },
  {
   "do": "click",
   "on": {
    "checkbox": "Enable workspace protection"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Apply"
   }
  },
  {
   "do": "rclick",
   "on": {
    "history_row": "B1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Merge into current workspace…"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Cancel"
   }
  }
 ]
}
