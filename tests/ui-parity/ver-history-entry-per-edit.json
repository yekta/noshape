   }
  },
  {
   "do": "rclick",
   "on": {
    "feature": "Extrude 2"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Unsuppress"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Versions and history"
   }
  },
  {
   "do": "click",
   "on": {
