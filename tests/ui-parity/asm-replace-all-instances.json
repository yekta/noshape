{
  "name": "asm-replace-all-instances",
  "about": "Replace instance on Part 2 <1> › Replace all instances ticked, then Escape",
  "area": "assembly",
  "source": "live2 11-14: asm field-level coverage (dialog options no scenario touched; lead: the asm/drawing half of the coverage audit)",
  "start": "two-blocks",
  "steps": [
    {
      "do": "click",
      "on": {
        "instance": "Part 2 <1>"
      }
    },
    {
      "do": "click",
      "on": {
        "tool": "Replace instance"
      }
    },
    {
      "do": "wait",
      "until": "dialog"
    },
    {
      "do": "click",
      "on": {
        "checkbox": "Replace all instances"
      }
    },
    {
      "do": "wait",
      "until": "regenerated"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "wait",
      "until": "regenerated"
    }
  ]
}
