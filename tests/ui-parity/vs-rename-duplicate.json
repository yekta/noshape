{
 "name": "vs-rename-duplicate",
 "about": "a Name cell renamed to another variable's name: reverts",
 "area": "studios",
 "source": "everyday (studios 11-08, Variable Studio batch 2)",
 "start": "vs-vars",
 "steps": [
  {
   "do": "click",
   "on": {
    "doc_tab": "Variable Studio 1"
   }
  },
  {
   "do": "click",
   "on": {
    "var_cell": "width:Name"
   }
  },
  {
   "do": "key",
   "key": "mod+a"
  },
  {
   "do": "type",
   "text": "height"
  },
  {
   "do": "key",
   "key": "Enter"
  }
 ]
}
