{
  "name": "drw-weld-flip-symbol",
  "about": "Weld symbol: Flip symbol clicked before a symbol is chosen (live keeps Flip symbol, Stagger, Symmetric and Reference disabled until a symbol is picked, so the click does nothing), then placed",
  "area": "drawing",
  "source": "live2 11-14: drawing field-level coverage (panel options no scenario touched; lead: the asm/drawing half of the coverage audit)",
  "start": "block-drawing",
  "steps": [
    {
      "do": "click",
      "on": {
        "tool": "Weld symbol"
      }
    },
    {
      "do": "wait",
      "until": "ms",
      "ms": 1000
    },
    {
      "do": "click",
      "on": {
        "checkbox": "Flip symbol"
      }
    },
    {
      "do": "wait",
      "until": "ms",
      "ms": 800
    },
    {
      "do": "click",
      "on": {
        "view_edge": {
          "view": "Front",
          "at": [
            20,
            0,
            10
          ]
        }
      }
    },
    {
      "do": "click",
      "on": {
        "view_point": {
          "view": "Front",
          "at": [
            30,
            0,
            22
          ]
        }
      }
    },
    {
      "do": "wait",
      "until": "ms",
      "ms": 1000
    },
    {
      "do": "key",
      "key": "Escape"
    }
  ]
}
