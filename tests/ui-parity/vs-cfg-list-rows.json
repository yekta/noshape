{
 "name": "vs-cfg-list-rows",
 "about": "Insert into all off, Configure Variable Studio, the list's italic Name row: Large, Enter; then the Large row (the configuration shown)",
 "area": "psui",
 "source": "universe variable-studio (psui 11-08, studios' coverage list)",
 "start": "vs-vars",
 "steps": [
  {
   "do": "click",
   "on": {
    "doc_tab": "Variable Studio 1"
   }
  },
  {
   "do": "click",
   "on": {
    "checkbox": "Insert into all Part Studios and Assemblies"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Configuration panel"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Configure Variable Studio"
   }
  },
  {
   "do": "click",
   "on": {
    "config_row": "Name"
   }
  },
  {
   "do": "type",
   "text": "Large"
  },
  {
   "do": "key",
   "key": "Enter"
  },
  {
   "do": "click",
   "on": {
    "config_row": "Large"
   }
  }
 ]
}
