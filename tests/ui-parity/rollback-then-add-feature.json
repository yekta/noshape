   "on": {
    "feature": "Sketch 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Roll to here"
   }
  },
  {
   "do": "wait",
   "until": "regenerated"
  },
  {
   "do": "click",
   "on": {
    "feature": "Sketch 1"
   }
  },
  {
   "do": "key",
   "key": "shift+e"
  },
  {
   "do": "click",
   "on": {
    "button": "ok"
   }
  },
  {
   "do": "wait",
   "until": "regenerated"
  }
 ]
