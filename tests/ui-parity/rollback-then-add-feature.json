{
 "name": "rollback-then-add-feature",
 "about": "roll back to Sketch 1, then Shift+E on the Sketch 1 row: the new Extrude goes in at the bar",
 "area": "psui",
 "source": "everyday",
 "start": "block",
 "steps": [
  {
