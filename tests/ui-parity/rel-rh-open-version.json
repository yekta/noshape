{
 "name": "rel-rh-open-version",
 "about": "After releasing Part 1: Revision history, then the row's version name R1: the released version opens, view only",
 "area": "studios",
 "source": "spec from Onshape docs, not recordable on live's plan (studios 11-08, release batch 1)",
 "recordable": false,
 "start": "doc-versions",
 "steps": [
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Release…"
   }
  },
  {
   "do": "click",
   "on": {
    "field": "Part number:Part 1"
   }
  },
  {
   "do": "type",
   "text": "PN-0001"
  },
  {
   "do": "click",
   "on": {
    "field": "Release name"
   }
  },
  {
   "do": "type",
   "text": "R1"
  },
  {
   "do": "click",
   "on": {
    "button": "Release"
   }
  },
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Revision history"
   }
  },
  {
   "do": "click",
   "on": {
    "history_row": "R1"
   }
  }
 ]
}
