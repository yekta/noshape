{
 "name": "doc-copy-version",
 "about": "Versions and history › V1 opened, then ☰ › Copy version… (\"Copy the active version to a new document\"), Cancel",
 "area": "psui",
 "source": "universe documents (psui 11-09, studios.md batch 7)",
 "start": "doc-versions",
 "steps": [
  {
   "do": "click",
   "on": {
    "button": "Versions and history"
   }
  },
  {
   "do": "click",
   "on": {
    "history_row": "V1"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Document menu"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Copy version…"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "modal-cancel"
   }
  }
 ]
}
