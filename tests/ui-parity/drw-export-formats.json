{
  "name": "drw-export-formats",
  "about": "Export dialog: its fields for DWG, DXF, PNG and SVG, then cancel",
  "area": "dx",
  "ticket": "DRAWING-UI-PARITY",
  "source": "coverage (lead 11-06: most-used drawing tools first)",
  "start": "block-drawing",
  "steps": [
    {
      "do": "rclick",
      "on": {
        "doc_tab": "Part 1 Drawing 1"
      }
    },
    {
      "do": "click",
      "on": {
        "menu": "Export…"
      }
    },
    {
      "do": "wait",
      "until": "dialog"
    },
    {
      "do": "click",
      "on": {
        "dropdown": "PDF",
        "pick": "DWG"
      }
    },
    {
      "do": "click",
      "on": {
        "dropdown": "DWG",
        "pick": "DXF"
      }
    },
    {
      "do": "click",
      "on": {
        "dropdown": "DXF",
        "pick": "PNG"
      }
    },
    {
      "do": "click",
      "on": {
        "dropdown": "PNG",
        "pick": "SVG"
      }
    },
    {
      "do": "click",
      "on": {
        "button": "cancel"
      }
    }
  ]
}
