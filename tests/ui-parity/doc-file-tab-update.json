{
 "name": "doc-file-tab-update",
 "about": "A STEP file tab's Update… › the same file: re-imported at once, no Import modal (live 2430)",
 "area": "studios",
 "source": "studios 11-12 (documents coverage: pick_files)",
 "start": "doc-cad-file",
