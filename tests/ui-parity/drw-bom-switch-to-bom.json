{
  "name": "drw-bom-switch-to-bom",
  "about": "The Sheets panel's BOM row (named after its assembly) › Switch to BOM (opens the assembly's BOM)",
  "area": "dx",
  "ticket": "DRAWING-UI-PARITY",
  "source": "coverage (lead 11-07: the remaining drawing menu items)",
  "start": "pin-block-asm-drawing",
  "steps": [
    {
      "do": "click",
      "on": {
        "tool": "BOM table"
      }
    },
    {
      "do": "click",
      "on": {
        "sheet_point": [
          260,
          200
        ]
      }
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "key",
      "key": "ctrl+s"
    },
    {
      "do": "wait",
      "until": "ms",
      "ms": 500
    },
    {
      "do": "rclick",
      "on": {
        "sheet_table": "start asm"
      }
    },
    {
      "do": "click",
      "on": {
        "menu": "Switch to BOM"
      }
    },
    {
      "do": "wait",
      "until": "ms",
      "ms": 1000
    }
  ]
}
