   "on": {
    "menu": "Release…"
   }
  },
  {
   "do": "click",
   "on": {
    "field": "Part number:Part 1"
   }
  },
  {
   "do": "type",
   "text": "PN-0001"
  },
  {
   "do": "click",
   "on": {
    "field": "Release name"
   }
  },
  {
   "do": "type",
   "text": "R1"
  },
  {
   "do": "click",
   "on": {
    "button": "Release"
   }
  },
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Revision history"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Obsolete revision"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Add to Obsoletion…"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Cancel"
   }
  }
 ]
