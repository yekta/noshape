{
 "name": "export-parts-two-selected",
 "about": "spline-parts: Part 1 and Part 3 selected in the parts list, right-click \u203a Export\u2026, Format STL: the Export 2 Parts dialog",
 "area": "export",
 "source": "live depth batch 8 (after modelling: export, measure, mass properties, section view; lead 11-27)",
 "start": "spline-parts",
 "steps": [
  {
   "do": "click",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "part": "Part 3",
    "mods": "shift"
   }
  },
  {
   "do": "rclick",
   "on": {
    "part": "Part 3"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Export\u2026"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1500
  },
  {
   "do": "click",
   "on": {
    "dropdown": "Format",
    "pick": "STL"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 1500
  },
  {
   "do": "click",
   "on": {
    "dropdown": "Options",
    "pick": "Store file in a new tab"
   }
  },
  {
   "do": "click",
   "on": {
    "dropdown": "Resolution",
    "pick": "Medium"
   }
  },
  {
   "do": "click",
   "on": {
    "dropdown": "Units",
    "pick": "Millimeter"
   }
  },
  {
   "do": "wait",
   "until": "ms",
   "ms": 800
  }
 ]
}