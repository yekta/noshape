 "fs-custom": {"units": "mm", "features": [{"type": "newSketch", "name": "Sketch 1", "plane": "Top", "shapes": [{"corner_rectangle": [[0, 0], [40, 30]]}]}, {"type": "extrude", "name": "Extrude 1", "params": {"entities": ["Sketch 1 region 0"], "endBound": "BLIND", "depth": "10 mm", "operationType": "NEW"}}], "feature_studio": {"name": "Feature Studio 1", "source": "FeatureScript 3112;\nimport(path : \"onshape/std/common.fs\", version : \"3112.0\");\nimport(path : \"onshape/std/table.fs\", version : \"3112.0\");\n\nannotation { \"Feature Type Name\" : \"uip Feature\" }\nexport const uipFeature = defineFeature(function(context is Context, id is Id, definition is map)\n    precondition\n    {\n        annotation { \"Name\" : \"Depth\" }\n        isLength(definition.depth, LENGTH_BOUNDS);\n    }\n    {\n        println(\"uip depth \" ~ toString(definition.depth));\n        if (definition.depth > 30 * millimeter)\n            throw regenError(\"uip too deep\");\n    });\n\nannotation { \"Table Type Name\" : \"Part faces\" }\nexport const partFaces = defineTable(function(context is Context, definition is map) returns Table\n    precondition\n    {\n    }\n    {\n        const columns = [tableColumnDefinition(\"name\", \"Part\"), tableColumnDefinition(\"faces\", \"Faces\"), tableColumnDefinition(\"check\", \"Check\"), tableColumnDefinition(\"info\", \"Info\")];\n        var rows = [];\n        for (var body in evaluateQuery(context, qAllModifiableSolidBodies()))\n            rows = append(rows, tableRow({ \"name\" : getProperty(context, { \"entity\" : body, \"propertyType\" : PropertyType.NAME }), \"faces\" : size(evaluateQuery(context, qOwnedByBody(body, EntityType.FACE))), \"check\" : tableCellError(\"?\", \"uip check\"), \"info\" : tableCellWithInfo(0, \"uip info\") }, body));\n        return table(\"Faces\", columns, rows);\n    });\n"}, "versions": [{"name": "V1"}], "about": "block's 40 x 30 x 10 box in Part Studio 1, then Feature Studio 1 (committed) defining the custom feature \"uip Feature\" (Depth; it printlns the depth and throws \"uip too deep\" past 30 mm) and the custom table \"Part faces\" (table \"Faces\": Part, Faces, Check: an error cell \"?\" with \"uip check\", Info: 0 with the info \"uip info\"), then version V1 (dx 11-08)"},
