{
 "name": "rel-obsolete",
 "about": "After releasing Part 1: Revision history › Obsolete revision: Create Obsolete candidate, Mark revision as re-releasable, its notes (required), Obsolete; Revision history again: View obsoletion",
 "area": "studios",
 "source": "spec from Onshape docs, not recordable on live's plan (studios 11-08, release batch 1) Recordable since 11-14 (Professional): a company-owned start (live2 COMPANYOWNED=1), managed workflows on.",
 "recordable": true,
 "start": "doc-versions",
 "config_files": {
  "release_settings.json": {
   "managed_workflows": true
  }
 },
 "steps": [
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Release…"
   }
  },
  {
   "do": "click",
   "on": {
    "field": "Part number:Part 1"
   }
  },
  {
   "do": "type",
   "text": "PN-0001"
  },
  {
   "do": "click",
   "on": {
    "field": "Release name"
   }
  },
  {
   "do": "type",
   "text": "R1"
  },
  {
   "do": "click",
   "on": {
    "button": "Release"
   }
  },
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Revision history…"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "Obsolete revision"
   }
  },
  {
   "do": "click",
   "on": {
    "checkbox": "Mark revision as re-releasable"
   }
  },
  {
   "do": "click",
   "on": {
    "field": "Release name"
   }
  },
  {
   "do": "type",
   "text": "O1"
  },
  {
   "do": "click",
   "on": {
    "field": "Release notes"
   }
  },
  {
   "do": "type",
   "text": "Replaced by PN-0002"
  },
  {
   "do": "click",
   "on": {
    "button": "Obsolete"
   }
  },
  {
   "do": "rclick",
   "on": {
    "part": "Part 1"
   }
  },
  {
   "do": "click",
   "on": {
    "menu": "Revision history…"
   }
  },
  {
   "do": "click",
   "on": {
    "button": "View obsoletion"
   }
  }
 ]
}
