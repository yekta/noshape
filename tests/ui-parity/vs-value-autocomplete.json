{
 "name": "vs-value-autocomplete",
 "about": "a Value cell: '#w' shows the autocomplete; Escape",
 "area": "studios",
 "source": "everyday (studios 11-08, Variable Studio batch 2)",
 "start": "vs-vars",
 "steps": [
  {
   "do": "click",
   "on": {
    "doc_tab": "Variable Studio 1"
   }
  },
  {
   "do": "click",
   "on": {
    "var_cell": "height:Value"
   }
  },
  {
   "do": "key",
   "key": "mod+a"
  },
  {
   "do": "type",
   "text": "#w"
  },
  {
   "do": "key",
   "key": "Escape"
  }
 ]
}
