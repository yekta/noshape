+// noshape: the congruence key of a pair of faces: their TShapes, orientations
+// and the location of the second relative to the first (rounded).
+static std::string CongruenceKey(const TopoDS_Shape& theS1, const TopoDS_Shape& theS2)
+{
+  const gp_Trsf aRel = theS1.Location().Transformation().Inverted() * theS2.Location().Transformation();
+  char          aBuf[512];
+  int           aN = std::snprintf(aBuf, sizeof aBuf, "%p %p %d %d", (void*)theS1.TShape().get(), (void*)theS2.TShape().get(), (int)theS1.Orientation(), (int)theS2.Orientation());
+  for (int r = 1; r <= 3; ++r)
+    for (int c = 1; c <= 4; ++c)
+    {
+      const double v = aRel.Value(r, c);
+      aN += std::snprintf(aBuf + aN, sizeof aBuf - (size_t)aN, " %.9g", std::abs(v) < 1e-12 ? 0.0 : v);
+    }
+  return std::string(aBuf, (size_t)aN);
+}
