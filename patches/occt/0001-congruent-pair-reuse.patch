+// noshape: the congruence key of a vertex-face pair: the face's TShape and
+// orientation, the vertex's point in the face's own frame (rounded) and its
+// tolerance. ComputeVF depends on nothing else, so congruent pairs (pattern
+// instances, and the vertices made where congruent edges cross) share it.
+static std::string CongruenceKey(const TopoDS_Vertex& theV, const TopoDS_Face& theF)
+{
+  const gp_Pnt aP = BRep_Tool::Pnt(theV).Transformed(theF.Location().Transformation().Inverted());
+  char         aBuf[256];
+  const int    aN = std::snprintf(aBuf, sizeof aBuf, "%p %d %.10g %.10g %.10g %.9g", (void*)theF.TShape().get(), (int)theF.Orientation(), std::abs(aP.X()) < 1e-12 ? 0.0 : aP.X(), std::abs(aP.Y()) < 1e-12 ? 0.0 : aP.Y(), std::abs(aP.Z()) < 1e-12 ? 0.0 : aP.Z(), BRep_Tool::Tolerance(theV));
+  return std::string(aBuf, (size_t)aN);
+}
