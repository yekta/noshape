+// noshape: GetStickVertices for many face pairs. The interferences that
+// made a new vertex, by the shapes taking part (built once): a face pair
+// looks at those of its own sub-shapes instead of every interference of the
+// DS (quadratic: 43,000 face pairs against 800,000 interferences in a
+// diamond knurl).
+namespace
+{
+struct StickIndex
+{
+  // shape index -> (type 0..4 = VV, VE, EE, VF, EF; interference index)
+  std::unordered_map<int, std::vector<std::pair<int, int>>> by;
+};
+
+StickIndex MakeStickIndex(BOPDS_DS* theDS)
+{
+  StickIndex aX;
+  auto       add = [&](int theType, int theI, const BOPDS_Interf& theInt) {
+    if (!theInt.HasIndexNew())
+      return;
+    int n1, n2;
+    theInt.Indices(n1, n2);
+    aX.by[n1].emplace_back(theType, theI);
+    if (n2 != n1)
+      aX.by[n2].emplace_back(theType, theI);
+  };
+  for (int i = 0; i < theDS->InterfVV().Length(); ++i)
+    add(0, i, theDS->InterfVV()(i));
+  for (int i = 0; i < theDS->InterfVE().Length(); ++i)
+    add(1, i, theDS->InterfVE()(i));
+  for (int i = 0; i < theDS->InterfEE().Length(); ++i)
+    add(2, i, theDS->InterfEE()(i));
+  for (int i = 0; i < theDS->InterfVF().Length(); ++i)
+    add(3, i, theDS->InterfVF()(i));
+  for (int i = 0; i < theDS->InterfEF().Length(); ++i)
+    add(4, i, theDS->InterfEF()(i));
+  return aX;
+}
+
+const BOPDS_Interf& StickInterf(BOPDS_DS* theDS, int theType, int theI)
+{
+  switch (theType)
+  {
+    case 0:
+      return theDS->InterfVV()(theI);
+    case 1:
+      return theDS->InterfVE()(theI);
+    case 2:
+      return theDS->InterfEE()(theI);
+    case 3:
+      return theDS->InterfVF()(theI);
+    default:
+      return theDS->InterfEF()(theI);
+  }
+}
+// The new vertices of the interferences among the sub-shapes `theMI` of a
+// face pair (GetStickVertices' result).
+void StickVertices(BOPDS_DS*                   theDS,
+                   const StickIndex&           theX,
+                   const NCollection_Map<int>& theMI,
+                   NCollection_Map<int>&       theMVStick,
+                   NCollection_Map<int>&       theMVEF)
+{
+  for (NCollection_Map<int>::Iterator aItS(theMI); aItS.More(); aItS.Next())
+  {
+    const auto aIt = theX.by.find(aItS.Value());
+    if (aIt == theX.by.end())
+      continue;
+    for (const auto& [aType, aI] : aIt->second)
+    {
+      const BOPDS_Interf& aInt = StickInterf(theDS, aType, aI);
+      int                 nS1, nS2;
+      aInt.Indices(nS1, nS2);
+      if (!theMI.Contains(nS1) || !theMI.Contains(nS2))
+        continue;
+      int nVNew = aInt.IndexNew();
+      theDS->HasShapeSD(nVNew, nVNew);
+      theMVStick.Add(nVNew);
+      if (aType == 4)
+        theMVEF.Add(nVNew);
+    }
+  }
+}
