+// noshape (patch 0037): a curve's samples are the same against every patch of the surface; Perform met the patches
+// one by one and sampled the whole curve again for each (an impeller flange's 669-pole edge against its shell's
+// offset wall: 8.4 s). Kept for one Perform call, by the curve and the range.
+struct CurveSamples
+{
+  const void*                              Curve;
+  double                                   U1, U2, Defl;
+  int                                      NbMin;
+  occ::handle<NCollection_HArray1<double>> Pars;
+};
+
+inline thread_local std::vector<CurveSamples>* t_curveSamples = nullptr;
+
+// One Perform call's samples: on for the scope's life, the outer scope's again after.
+class CurveSamplesScope
+{
+public:
+  CurveSamplesScope()
+      : myPrev(t_curveSamples)
+  {
+    t_curveSamples = &mySamples;
+  }
+
+  ~CurveSamplesScope() { t_curveSamples = myPrev; }
+
+  CurveSamplesScope(const CurveSamplesScope&)            = delete;
+  CurveSamplesScope& operator=(const CurveSamplesScope&) = delete;
+
+private:
+  std::vector<CurveSamples>* myPrev;
+  std::vector<CurveSamples>  mySamples;
+};
+
+template <typename CurveTool, typename CurveType>
+occ::handle<NCollection_HArray1<double>> SampleParsOnce(const CurveType& theCurve,
+                                                        const double     theU1,
+                                                        const double     theU2,
+                                                        const double     theDefl,
+                                                        const int        theNbMin)
+{
+  std::vector<CurveSamples>* aCache = t_curveSamples;
+  if (aCache == nullptr)
+  {
+    return CurveTool::SamplePars(theCurve, theU1, theU2, theDefl, theNbMin);
+  }
+  const void* aCurve = &theCurve;
+  if constexpr (std::is_same_v<CurveType, occ::handle<Adaptor3d_Curve>>)
+  {
+    aCurve = theCurve.get();
+  }
+  for (const CurveSamples& aS : *aCache)
+  {
+    if (aS.Curve == aCurve && aS.U1 == theU1 && aS.U2 == theU2 && aS.Defl == theDefl && aS.NbMin == theNbMin)
+    {
+      return aS.Pars;
+    }
+  }
+  occ::handle<NCollection_HArray1<double>> aPars = CurveTool::SamplePars(theCurve, theU1, theU2, theDefl, theNbMin);
+  aCache->push_back({aCurve, theU1, theU2, theDefl, theNbMin, aPars});
+  return aPars;
+}
