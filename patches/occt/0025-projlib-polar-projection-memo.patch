+  gp_Pnt2d Value(const double t) const
+  {
+    // noshape: each parameter's projection kept: the fits ask for the same parameters again (four in ten of a Draft
+    // fallback's 84,000), each a local and often a global search on the surface.
+    uint64_t aKey;
+    std::memcpy(&aKey, &t, sizeof(aKey));
+    const auto aKept = myKept.find(aKey);
+    if (aKept != myKept.end())
+    {
+      return aKept->second;
+    }
+    const gp_Pnt2d aPnt = Function_Value(t, myStruct);
+    myKept.emplace(aKey, aPnt);
+    return aPnt;
+  }
 
