 #include <OSD.hxx>
 #include <OSD_Parallel.hxx>
@@ -188,8 +189,35 @@
 
 //=================================================================================================
 
+namespace
+{
+// noshape: how many pool jobs with worker threads this thread is running (it
+// takes part in them and waits for the workers). A CPU budget's siglongjmp
+// out of one would leave the workers on the abandoned stack frames (qa
+// BOP-PAIRS-GPF, BOOL-THREAD-CRASH): noshape's budget doesn't jump while it
+// isn't 0. A job of this thread alone (a serial BOPTools_Parallel loop) isn't
+// counted: jumping out of it is safe, and the budget must stop those.
+thread_local int THE_NOSHAPE_POOL_DEPTH = 0;
+
+struct NoshapePoolDepth
+{
+  NoshapePoolDepth() { ++THE_NOSHAPE_POOL_DEPTH; }
+  ~NoshapePoolDepth() { --THE_NOSHAPE_POOL_DEPTH; }
+};
+} // namespace
+
+extern "C" Standard_EXPORT int noshape_osd_pool_depth()
+{
+  return THE_NOSHAPE_POOL_DEPTH;
+}
+
 void OSD_ThreadPool::Launcher::perform(JobInterface& theJob)
 {
+  std::optional<NoshapePoolDepth> aDepth;
+  if (myNbThreads > 1)
+  {
+    aDepth.emplace();
+  }
   run(theJob);
   wait();
 }
