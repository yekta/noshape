+// noshape (patch 0029): the sample counts of the faces IsTangentFaces has seen in this thread's open SamplesScope.
+thread_local NCollection_DataMap<TopoDS_Shape, int, TopTools_ShapeMapHasher>* THE_SAMPLES = nullptr;
+
+int tangentSamples(const TopoDS_Face& theFace)
+{
+  if (THE_SAMPLES != nullptr)
+  {
+    if (const int* aKnown = THE_SAMPLES->Seek(theFace))
+    {
+      return *aKnown;
+    }
+  }
+  BRepAdaptor_Surface                   aBAS(theFace);
+  occ::handle<BRepAdaptor_Surface>      aBAHS = new BRepAdaptor_Surface(aBAS);
+  occ::handle<BRepTopAdaptor_TopolTool> aTool = new BRepTopAdaptor_TopolTool(aBAHS);
+  const int                             aNb   = aTool->NbSamples();
+  if (THE_SAMPLES != nullptr)
+  {
+    THE_SAMPLES->Bind(theFace, aNb);
+  }
+  return aNb;
+}
+} // namespace
+
+ChFi3d::SamplesScope::SamplesScope()
+    : myOwner(THE_SAMPLES == nullptr)
+{
+  if (myOwner)
+  {
+    THE_SAMPLES = new NCollection_DataMap<TopoDS_Shape, int, TopTools_ShapeMapHasher>();
+  }
+}
+
+ChFi3d::SamplesScope::~SamplesScope()
+{
+  if (myOwner)
+  {
+    delete THE_SAMPLES;
+    THE_SAMPLES = nullptr;
+  }
+}
 
