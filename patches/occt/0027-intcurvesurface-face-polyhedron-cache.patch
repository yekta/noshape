+// noshape: a face's polyhedron (its sampled surface, one per span of it) kept for the next curve against the same
+// surface and bounds: Boolean and defeaturing runs intersect every edge with every face, each call sampling the face's
+// spans again (c2-impeller-loft's Delete face 2: 503 polyhedra made 6,381 times). Keyed by what the polyhedron is
+// made from: the surface's kind, the bounds, the sample counts and its points on a 4 x 4 grid (in space: a moved copy
+// is another surface).
+template <typename SurfaceType, typename SurfaceTool>
+std::vector<double> PolyhedronKey(const SurfaceType& theSurface,
+                                  const int          theKind,
+                                  const double       theU1,
+                                  const double       theV1,
+                                  const double       theU2,
+                                  const double       theV2,
+                                  const int          theNbU,
+                                  const int          theNbV)
+{
+  std::vector<double> aKey{double(SurfaceTool::GetType(theSurface)), double(theKind), theU1, theV1, theU2, theV2, double(theNbU), double(theNbV)};
+  for (int i = 0; i <= 3; ++i)
+  {
+    for (int j = 0; j <= 3; ++j)
+    {
+      const gp_Pnt aP = SurfaceTool::Value(theSurface, theU1 + (theU2 - theU1) * (0.1 + 0.8 * i / 3.0), theV1 + (theV2 - theV1) * (0.1 + 0.8 * j / 3.0));
+      // (To 1e-11: two adaptors of one surface can differ in the last bits, their span caches apart.)
+      aKey.push_back(std::round(aP.X() * 1e11));
+      aKey.push_back(std::round(aP.Y() * 1e11));
+      aKey.push_back(std::round(aP.Z() * 1e11));
+    }
+  }
+  return aKey;
+}
+
+template <typename PolyhedronType, typename MakeFunc>
+std::shared_ptr<const PolyhedronType> CachedPolyhedron(std::vector<double>&& theKey, MakeFunc theMake)
+{
+  // (One for all threads (the pave filler's pairs on the pool each meet most of a part's faces), built outside the
+  // lock; emptied past 300k sample points.)
+  static std::mutex                                                          aMutex;
+  static std::map<std::vector<double>, std::shared_ptr<const PolyhedronType>> aCache;
+  static size_t                                                              aPoints = 0;
+  {
+    std::lock_guard<std::mutex> aLock(aMutex);
+    const auto                  anIt = aCache.find(theKey);
+    if (anIt != aCache.end())
+    {
+      return anIt->second;
+    }
+  }
+  std::shared_ptr<const PolyhedronType> aPoly(theMake());
+  std::lock_guard<std::mutex>           aLock(aMutex);
+  if (aPoints > 300000)
+  {
+    aCache.clear();
+    aPoints = 0;
+  }
+  const auto anIns = aCache.emplace(std::move(theKey), aPoly);
+  if (anIns.second)
+  {
+    aPoints += static_cast<size_t>(std::max(aPoly->NbPoints(), 0));
+  }
+  return anIns.first->second;
+}
