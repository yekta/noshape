+// noshape: parallel shape processing. Before a root product's transfer, the
+// main shape representations of its sub-products are transferred first,
+// with the shape processing (ShapeFix) of their items deferred; the items
+// are then processed in parallel, each exactly as it would have been (its
+// own parameters and precision), their transfer information merged over the
+// entities they mapped and the representations' compounds rebuilt with the
+// processed items. The root's transfer then finds those representations
+// transferred and builds the assembly from them: the results of the serial
+// order.
+namespace
+{
+struct DeferredProcessing
+{
+  TopoDS_Shape                                                             Shape;
+  XSAlgo_ShapeProcessor::ParameterMap                                      Parameters;
+  ShapeProcess::OperationsFlags                                            Flags;
+  int                                                                      First = 0, Last = 0;
+  occ::handle<TransferBRep_ShapeBinder>                                    Binder;
+  TopoDS_Shape                                                             Result;
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> Modified;
+  bool                                                                     Failed = false;
+};
+
+std::atomic<bool>                             THE_DEFER_PROCESSING{true};
+thread_local std::vector<DeferredProcessing>* THE_DEFERRED       = nullptr;
+thread_local int                              THE_TRANSFER_DEPTH = 0;
+// The transfer process whose products were pre-transferred (once, at its
+// first root).
+thread_local const Transfer_TransientProcess* THE_PRETRANSFERRED = nullptr;
+
+// XSAlgo_ShapeProcessor::MergeShapeTransferInfo over items theFirst..theLast
+// only (the ones the representation item mapped).
+void mergeDeferred(const occ::handle<Transfer_TransientProcess>&                            theTP,
+                   const NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>& theMap,
+                   const int                                                                theFirst,
+                   const int                                                                theLast)
+{
+  if (theMap.IsEmpty())
+  {
+    return;
+  }
+  for (int i = std::max(theFirst, 1); i <= std::min(theLast, theTP->NbMapped()); ++i)
+  {
+    occ::handle<TransferBRep_ShapeBinder> aBinder = occ::down_cast<TransferBRep_ShapeBinder>(theTP->MapItem(i));
+    if (aBinder.IsNull() || aBinder->Result().IsNull())
+    {
+      continue;
+    }
+    const TopoDS_Shape anOriginal = aBinder->Result();
+    if (theMap.IsBound(anOriginal))
+    {
+      aBinder->SetResult(theMap.Find(anOriginal));
+    }
+    else if (!anOriginal.Location().IsIdentity())
+    {
+      const TopoDS_Shape anUnlocated = anOriginal.Located(TopLoc_Location());
+      if (theMap.IsBound(anUnlocated))
+      {
+        aBinder->SetResult(theMap.Find(anUnlocated));
+      }
+    }
+    else
+    {
+      BRepTools_ReShape aReShaper;
+      bool              aModified = false;
+      for (TopExp_Explorer anExp(anOriginal, TopAbs_EDGE); anExp.More(); anExp.Next())
+      {
+        if (theMap.IsBound(anExp.Current()))
+        {
+          aModified = true;
+          aReShaper.Replace(anExp.Current(), theMap.Find(anExp.Current()));
+        }
+      }
+      if (aModified)
+      {
+        aBinder->SetResult(aReShaper.Apply(anOriginal));
+      }
+    }
+  }
+}
+} // namespace
+
+void STEPControl_ActorRead::SetDeferredShapeProcessing(const bool theToDefer)
+{
+  THE_DEFER_PROCESSING = theToDefer;
+}
