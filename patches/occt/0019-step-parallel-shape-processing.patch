+void STEPControl_ActorRead::preTransferRepresentations(const occ::handle<StepBasic_ProductDefinition>& theRoot,
+                                                       const occ::handle<Transfer_TransientProcess>&   TP,
+                                                       const StepData_Factors&                         theLocalFactors,
+                                                       const bool                                      theRootTrsf)
+{
+  occ::handle<StepData_StepModel> aStepModel   = occ::down_cast<StepData_StepModel>(TP->Model());
+  const int                       readAssembly = aStepModel->InternalParameters.ReadAssemblyLevel;
+  if (readAssembly == 3 || readAssembly == 4)
+  {
+    return;
+  }
+  const Interface_Graph& aGraph = TP->Graph();
+  // Every product: the top ones (no assembly usage takes them: the roots a
+  // transfer of all roots goes through) and their sub-products.
+  NCollection_Map<occ::handle<Standard_Transient>>      aUsed;
+  std::vector<occ::handle<StepBasic_ProductDefinition>> aQueue;
+  for (int e = 1; e <= aStepModel->NbEntities(); ++e)
+  {
+    occ::handle<StepRepr_NextAssemblyUsageOccurrence> aNAUO = occ::down_cast<StepRepr_NextAssemblyUsageOccurrence>(aStepModel->Value(e));
+    if (!aNAUO.IsNull() && !aNAUO->RelatedProductDefinition().IsNull())
+    {
+      aUsed.Add(aNAUO->RelatedProductDefinition());
+    }
+  }
+  NCollection_Map<occ::handle<Standard_Transient>> aSeen;
+  aQueue.push_back(theRoot);
+  aSeen.Add(theRoot);
+  for (int e = 1; e <= aStepModel->NbEntities(); ++e)
+  {
+    occ::handle<StepBasic_ProductDefinition> aPD = occ::down_cast<StepBasic_ProductDefinition>(aStepModel->Value(e));
+    if (!aPD.IsNull() && !aUsed.Contains(aPD) && aSeen.Add(aPD))
+    {
+      aQueue.push_back(aPD);
+    }
+  }
+  const size_t aNbTop = aQueue.size();
+  for (size_t q = 0; q < aQueue.size(); ++q)
+  {
+    Interface_EntityIterator anIt = aGraph.Sharings(aQueue[q]);
+    for (anIt.Start(); anIt.More(); anIt.Next())
+    {
+      occ::handle<StepRepr_NextAssemblyUsageOccurrence> aNAUO = occ::down_cast<StepRepr_NextAssemblyUsageOccurrence>(anIt.Value());
+      if (aNAUO.IsNull() || aNAUO->RelatingProductDefinition() != aQueue[q])
+      {
+        continue;
+      }
+      occ::handle<StepBasic_ProductDefinition> aChild = aNAUO->RelatedProductDefinition();
+      if (!aChild.IsNull() && aSeen.Add(aChild))
+      {
+        aQueue.push_back(aChild);
+      }
+    }
+  }
+  // Their main shape representations, as TransferEntity (PD) takes them.
+  // (Each with the root-placement flag TransferEntity (PD) gives it: the
+  // reader's for a top product's, none for a sub-product's; one reached both
+  // ways is left to the transfer itself.)
+  std::vector<std::pair<occ::handle<StepShape_ShapeRepresentation>, bool>> aReps;
+  NCollection_DataMap<occ::handle<Standard_Transient>, bool>             aRepTrsf;
+  NCollection_Map<occ::handle<Standard_Transient>>                        aConflict;
+  auto aTake = [&](const occ::handle<StepShape_ShapeRepresentation>& theRep, const bool theTrsf) {
+    if (theRep.IsNull() || TP->IsBound(theRep))
+    {
+      return;
+    }
+    if (aRepTrsf.IsBound(theRep))
+    {
+      if (aRepTrsf.Find(theRep) != theTrsf)
+      {
+        aConflict.Add(theRep);
+      }
+      return;
+    }
+    aRepTrsf.Bind(theRep, theTrsf);
+    aReps.emplace_back(theRep, theTrsf);
+  };
+  for (size_t q = 0; q < aQueue.size(); ++q)
+  {
+    const bool aTrsf = q < aNbTop && theRootTrsf;
+    occ::handle<NCollection_HSequence<occ::handle<Standard_Transient>>> aSDR    = new NCollection_HSequence<occ::handle<Standard_Transient>>;
+    occ::handle<NCollection_HSequence<occ::handle<Standard_Transient>>> aNAUO   = new NCollection_HSequence<occ::handle<Standard_Transient>>;
+    occ::handle<NCollection_HSequence<occ::handle<Standard_Transient>>> anAspect = new NCollection_HSequence<occ::handle<Standard_Transient>>;
+    Interface_EntityIterator anIt = aGraph.Sharings(aQueue[q]);
+    for (anIt.Start(); anIt.More(); anIt.Next())
+    {
+      occ::handle<StepRepr_ProductDefinitionShape> aPDS = occ::down_cast<StepRepr_ProductDefinitionShape>(anIt.Value());
+      if (!aPDS.IsNull())
+      {
+        getSDR(aPDS, aSDR, aNAUO, anAspect, TP);
+        continue;
+      }
+      occ::handle<StepRepr_NextAssemblyUsageOccurrence> aUsage = occ::down_cast<StepRepr_NextAssemblyUsageOccurrence>(anIt.Value());
+      if (!aUsage.IsNull() && aUsage->RelatingProductDefinition() == aQueue[q])
+      {
+        aNAUO->Append(aUsage);
+      }
+    }
+    if (readAssembly == 2 && aNAUO->Length() > 0)
+    {
+      continue;
+    }
+    for (int i = 1; i <= aSDR->Length(); ++i)
+    {
+      occ::handle<StepShape_ShapeDefinitionRepresentation> aDef = occ::down_cast<StepShape_ShapeDefinitionRepresentation>(aSDR->Value(i));
+      occ::handle<StepShape_ShapeRepresentation> aRep = aDef.IsNull() ? occ::handle<StepShape_ShapeRepresentation>() : occ::down_cast<StepShape_ShapeRepresentation>(aDef->UsedRepresentation());
+      if (aRep.IsNull())
+      {
+        continue;
+      }
+      aTake(aRep, aTrsf);
+      // The representations related to it (TransferRelatedSRR: Onshape's
+      // solids are in a related advanced B-rep representation).
+      if (!aStepModel->InternalParameters.ReadRelationship)
+      {
+        continue;
+      }
+      for (Interface_EntityIterator aRel(aGraph.Sharings(aRep)); aRel.More(); aRel.Next())
+      {
+        if (aRel.Value()->DynamicType() != STANDARD_TYPE(StepRepr_ShapeRepresentationRelationship))
+        {
+          continue;
+        }
+        occ::handle<StepRepr_ShapeRepresentationRelationship> aSRR = occ::down_cast<StepRepr_ShapeRepresentationRelationship>(aRel.Value());
+        aTake(occ::down_cast<StepShape_ShapeRepresentation>(aRep == aSRR->Rep1() ? aSRR->Rep2() : aSRR->Rep1()), aTrsf);
+      }
+    }
+  }
+  if (aReps.size() < 2)
+  {
+    return;
+  }
+  // Transferred with their items' processing deferred.
+  struct RepTransfer
+  {
+    occ::handle<StepShape_ShapeRepresentation> Rep;
+    size_t                                     FirstJob = 0, EndJob = 0;
+    int                                        First = 0, Last = 0;
+  };
+  std::vector<DeferredProcessing> aJobs;
+  std::vector<RepTransfer>        aRepJobs;
+  THE_DEFERRED = &aJobs;
+  try
+  {
+    for (const auto& [aRep, aTrsf] : aReps)
+    {
+      if (TP->IsBound(aRep) || aConflict.Contains(aRep))
+      {
+        continue;
+      }
+      RepTransfer aTransfer;
+      aTransfer.Rep      = aRep;
+      aTransfer.FirstJob = aJobs.size();
+      aTransfer.First    = TP->NbMapped() + 1;
+      bool isBound       = false;
+      TransferEntity(aRep, TP, theLocalFactors, isBound, aTrsf, Message_ProgressRange());
+      aTransfer.EndJob = aJobs.size();
+      aTransfer.Last   = TP->NbMapped();
+      aRepJobs.push_back(aTransfer);
+    }
+  }
+  catch (...)
+  {
+    THE_DEFERRED = nullptr;
+    throw;
+  }
+  THE_DEFERRED = nullptr;
+  if (aJobs.empty())
+  {
+    return;
+  }
+  ShapeProcess_OperLibrary::Init();
+  OSD_Parallel::For(0, (int)aJobs.size(), [&](const int theIndex) {
+    DeferredProcessing& aJob = aJobs[(size_t)theIndex];
+    try
+    {
+      XSAlgo_ShapeProcessor aProcessor(aJob.Parameters);
+      aJob.Result = aProcessor.ProcessShape(aJob.Shape, aJob.Flags, Message_ProgressRange());
+      if (!aProcessor.GetContext().IsNull())
+      {
+        aJob.Modified = aProcessor.GetContext()->Map();
+      }
+    }
+    catch (const Standard_Failure&)
+    {
+      aJob.Failed = true;
+    }
+  });
+  // In order: each item's transfer information, then the shapes its
+  // representation built from the items (its compound, related and mapped
+  // representations), as built from the processed items.
+  for (const RepTransfer& aTransfer : aRepJobs)
+  {
+    occ::handle<BRepTools_ReShape> aReShape = new BRepTools_ReShape();
+    bool                           aChanged = false;
+    for (size_t j = aTransfer.FirstJob; j < aTransfer.EndJob; ++j)
+    {
+      DeferredProcessing& aJob = aJobs[j];
+      if (aJob.Failed)
+      {
+        TP->AddWarning(aTransfer.Rep, "Shape processing of an item failed; the item is kept as translated");
+        continue;
+      }
+      mergeDeferred(TP, aJob.Modified, aJob.First, aJob.Last);
+      if (!aJob.Binder.IsNull())
+      {
+        aJob.Binder->SetResult(aJob.Result);
+      }
+      if (!aJob.Shape.IsSame(aJob.Result) || aJob.Shape.Location() != aJob.Result.Location())
+      {
+        aReShape->Replace(aJob.Shape, aJob.Result);
+        aChanged = true;
+      }
+    }
+    if (!aChanged)
+    {
+      continue;
+    }
+    auto anItemOwn = [&](const int theIndex) {
+      for (size_t j = aTransfer.FirstJob; j < aTransfer.EndJob; ++j)
+      {
+        if (theIndex >= aJobs[j].First && theIndex <= aJobs[j].Last)
+        {
+          return true;
+        }
+      }
+      return false;
+    };
+    auto aRebuild = [&](const occ::handle<Transfer_Binder>& theBinder) {
+      occ::handle<TransferBRep_ShapeBinder> aBinder = occ::down_cast<TransferBRep_ShapeBinder>(theBinder);
+      if (aBinder.IsNull() || aBinder->Result().IsNull())
+      {
+        return;
+      }
+      for (size_t j = aTransfer.FirstJob; j < aTransfer.EndJob; ++j)
+      {
+        if (aBinder == aJobs[j].Binder)
+        {
+          return;
+        }
+      }
+      const TopoDS_Shape aNew = aReShape->Apply(aBinder->Result());
+      if (!aNew.IsEqual(aBinder->Result()))
+      {
+        aBinder->SetResult(aNew);
+      }
+    };
+    for (int i = aTransfer.First; i <= aTransfer.Last; ++i)
+    {
+      if (!anItemOwn(i))
+      {
+        aRebuild(TP->MapItem(i));
+      }
+    }
+    const int aRepIndex = TP->MapIndex(aTransfer.Rep);
+    if (aRepIndex > 0 && (aRepIndex < aTransfer.First || aRepIndex > aTransfer.Last))
+    {
+      aRebuild(TP->MapItem(aRepIndex));
+    }
+  }
+}
