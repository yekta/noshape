+// noshape: a pair with a free-form surface (B-spline, Bezier, revolution, extrusion, offset) costs a millisecond or
+// more where a pair of elementary ones costs microseconds: a few such pairs are worth the pool (c2-valve-config's
+// up-to extrude split its 26 free-form face pairs on one thread, 128 ms of 228).
+static bool noshapeFreeForm(const GeomAbs_SurfaceType theType)
+{
+  return theType == GeomAbs_BezierSurface || theType == GeomAbs_BSplineSurface || theType == GeomAbs_SurfaceOfRevolution
+         || theType == GeomAbs_SurfaceOfExtrusion || theType == GeomAbs_OffsetSurface || theType == GeomAbs_OtherSurface;
+}
