+// noshape (patch 0011): the pairs sorted as std::stable_sort did (equal pairs are the same pair, so their order
+// doesn't show), in chunks merged level by level with the break check between steps: one stable_sort of a knurl's
+// millions of pairs (a segmented array) ran ~1 s after the user's cancel.
+static void noshapeSortPairs(NCollection_DynamicArray<BOPDS_Pair>& theList)
+{
+  const int n = theList.Length();
+  std::vector<BOPDS_Pair> aV;
+  aV.reserve((size_t)n);
+  for (int i = 0; i < n; ++i)
+  {
+    noshapePairsCheck(i);
+    aV.push_back(theList(i));
+  }
+  const size_t aN = aV.size(), aChunk = 65536;
+  for (size_t s = 0; s < aN; s += aChunk)
+  {
+    noshapePairsCheck(0);
+    std::sort(aV.begin() + s, aV.begin() + std::min(s + aChunk, aN));
+  }
+  for (size_t w = aChunk; w < aN; w *= 2)
+    for (size_t s = 0; s + w < aN; s += 2 * w)
+    {
+      noshapePairsCheck(0);
+      std::inplace_merge(aV.begin() + s, aV.begin() + s + w, aV.begin() + std::min(s + 2 * w, aN));
+    }
+  for (int i = 0; i < n; ++i)
+  {
+    noshapePairsCheck(i);
+    theList(i) = aV[(size_t)i];
+  }
+}
