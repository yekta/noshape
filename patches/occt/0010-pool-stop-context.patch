+// noshape: the launching thread's stop context (its cancel flag and CPU
+// deadline, in noshape's kernel) taken by the pool's workers for the job, so
+// the break hooks (patches 0007-0009) stop a cancelled Boolean's parallel
+// face / face intersections there too: they ran on for 100s of ms after the
+// user's cancel. Null: nothing to hand on.
+extern "C" void* noshape_pool_capture();
+extern "C" void* noshape_pool_enter(void* theContext);
+extern "C" void  noshape_pool_leave(void* thePrevious);
+#if defined(__GNUC__)
+// The defaults for a program that doesn't define the hooks: nothing.
+extern "C" __attribute__((weak)) void* noshape_pool_capture()
+{
+  return nullptr;
+}
+
+extern "C" __attribute__((weak)) void* noshape_pool_enter(void*)
+{
+  return nullptr;
+}
+
+extern "C" __attribute__((weak)) void noshape_pool_leave(void*) {}
+#endif
+
+namespace
+{
+// (The pool's job interface is protected: named through a subclass.)
+struct NoshapePoolAccess : OSD_ThreadPool
+{
+  using Job = OSD_ThreadPool::JobInterface;
+};
+
+// A job run under the launching thread's stop context on every thread.
+class NoshapeJob : public NoshapePoolAccess::Job
+{
+public:
+  NoshapeJob(NoshapePoolAccess::Job& theJob, void* theContext)
+      : myJob(theJob),
+        myContext(theContext)
+  {
+  }
+
+  void Perform(int theThreadIndex) override
+  {
+    void* aPrevious = noshape_pool_enter(myContext);
+    try
+    {
+      myJob.Perform(theThreadIndex);
+    }
+    catch (...)
+    {
+      noshape_pool_leave(aPrevious);
+      throw;
+    }
+    noshape_pool_leave(aPrevious);
+  }
+
+private:
+  NoshapePoolAccess::Job& myJob;
+  void*                   myContext;
+};
+} // namespace
